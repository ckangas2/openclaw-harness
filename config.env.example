# Local settings for this machine. install.sh copies this file to config.env on first
# run; edit config.env (it is not tracked by git), not this example.

# Who the agents work for
USER_NAME="the user"

# Active packs, comma-separated, applied in order
PACKS="scrna-qc"

# Agents
WORKER_AGENT="grounded-pig"
AUDITOR_ID="auditor"
WORKER_WS="$HOME/.openclaw/workspace/workspace-grounded"
AUDITOR_WS="$HOME/.openclaw/workspace/auditor"

# Analysis environment the agents must check against
ENV_NAME="scrna_workflow"
CHECK_PY="$HOME/miniforge3/envs/scrna_workflow/bin/python"

# Project folders the worker may write in without asking (space-separated; paths without spaces).
# The worker's workspace and /tmp are always allowed. In a project folder, a
# .harness-python file containing an interpreter path overrides CHECK_PY for that project.
PROJECT_ROOTS=""

# Where eval runs are written (kept outside the repo and outside agent workspaces)
# RUNS_DIR=   # default: ${HARNESS_DATA:-<repo>/data}/agent-evals/runs. Set HARNESS_DATA to move all data.
